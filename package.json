{
  "name": "peabox-ide",
  "version": "0.14.0",
  "private": true,
  "description": "A focused, portable desktop code editor with reliable core developer workflows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "validate": "node tools/validate.js",
    "build:portable": "npm run validate && electron-builder --win portable zip --x64"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.peabox.ide",
    "productName": "PeaBox IDE",
    "artifactName": "PeaBox-IDE-${version}-Windows-${arch}.${ext}",
    "asar": true,
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "style.css", "package.json", "node_modules/**/*"],
    "win": {"target": ["portable", "zip"]}
  }
}
