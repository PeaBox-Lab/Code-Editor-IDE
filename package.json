{
  "name": "peabox-ide",
  "version": "0.17.0",
  "private": true,
  "description": "A fast, local-first desktop code editor with a lazy explorer, async search, Git integration, runtimes, terminals and crash recovery.",
  "main": "main.js",
  "author": "PeaBox",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "electron .",
    "validate": "node tools/validate.js",
    "test": "npm run validate && npm run test:unit",
    "test:unit": "node --test tests/unit.test.js",
    "test:e2e": "node tests/electron.spec.js",
    "build": "npm run validate && npm run test:unit && electron-builder --win portable zip --x64",
    "build:portable": "npm run build",
    "postinstall": "node tools/postinstall.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "write-file-atomic": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "eslint": "^9.0.0"
  },
  "build": {
    "appId": "com.peabox.ide",
    "productName": "PeaBox IDE",
    "artifactName": "PeaBox-IDE-${version}-Windows-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "shared.js",
      "index.html",
      "style.css",
      "package.json",
      "tests/**/*",
      "tools/**/*",
      "README.md",
      "AUDIT.md",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    }
  }
}
