{
  "name": "peabox-ide",
  "version": "0.13.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "npm run release:check && electron-builder --win portable zip --x64",
    "validate": "node tools/validate-release.js",
    "test:smoke": "node tools/smoke-test.js",
    "release:check": "npm run validate && npm run test:smoke && npm run test:reliability",
    "test:reliability": "node tools/atomic-save-test.js"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.peabox.ide",
    "productName": "PeaBox IDE",
    "artifactName": "PeaBox-IDE-${version}-Windows-${arch}.${ext}",
    "asar": true,
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    },
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!node_modules/.cache/**",
      "!*.log"
    ]
  },
  "productName": "PeaBox IDE",
  "description": "PeaBox IDE core reliability release with atomic saves, recovery buffers, file watching, ConPTY support, runtime propagation and workspace trust.",
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}