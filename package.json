{
  "name": "peabox-ide",
  "version": "0.7.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win portable zip --x64"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.peabox.ide",
    "productName": "PeaBox IDE",
    "artifactName": "PeaBox-IDE-${version}-${arch}.${ext}",
    "asar": true,
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    }
  },
  "productName": "PeaBox IDE"
}